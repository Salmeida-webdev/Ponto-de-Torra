# Chaves publicáveis do Supabase. Nunca coloque a chave secreta no navegador.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Asaas: sandbox até a validação completa do checkout e webhooks.
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_AUTH_TOKEN=

# Frenet: preencher somente após confirmar endpoint HTTPS de homologação.
FRENET_API_BASE_URL=
FRENET_CUSTOMER_TOKEN=
FRENET_PARTNER_TOKEN=
STORE_ORIGIN_POSTAL_CODE=

# URLs usadas nos callbacks do Checkout Asaas.
PUBLIC_SITE_URL=http://localhost:5173
